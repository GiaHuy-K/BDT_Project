# Copy to .env (run.sh does this automatically) and change passwords if needed.

# MinIO (raw + processed object storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=localhost:9000
RAW_BUCKET=raw
PROCESSED_BUCKET=processed

# PostgreSQL (serving layer + Metabase app DB)
POSTGRES_USER=bimbo
POSTGRES_PASSWORD=bimbo123
POSTGRES_DB=bimbo
POSTGRES_PORT=5432

# Local path of the Kaggle zip (downloaded by ingest.py if missing)
DATA_ZIP=data/grupo-bimbo-inventory-demand.zip
